# Admin settings scope and the posts site. The rest of the environment list is
# nextjs/.env.template. Copy that file to .env.local.
#
# Leave ADMIN_SETTINGS_APP_KEY unset when admin_settings has no app_key column.
# The app then does not filter, select, or write app_key. Set a unique value
# only after that column exists. Server-only. Do not prefix with NEXT_PUBLIC_.
ADMIN_SETTINGS_APP_KEY=

# Site written to and filtered on public.posts.website.
# Allowed values: edu, marketing-agent, afterallcare.
# Sample content on the shared database uses afterallcare.
# If this is unset or invalid, public post pages, RSS, and the sitemap render
# empty and log a warning. Writes return a configuration error.
POSTS_WEBSITE=
