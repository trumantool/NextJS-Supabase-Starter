# =============================================================================
# Next.js + Supabase starter — environment template
# =============================================================================
# Copy to nextjs/.env.local and fill in values from a NEW empty Supabase project.
#
#   cp .env.template .env.local
#
# Never reuse Marketing Agent infrastructure:
#   - Do not use project ID glplvrljdgowcwuubkau
#   - Do not use Vercel project marketing-agent-truman
#   - Do not paste keys from those projects
#
# Composio is out of v1. Do not add Composio keys.
# Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Supabase
# Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. This app reads PRIVATE_SUPABASE_SERVICE_KEY (not
# SUPABASE_SERVICE_ROLE_KEY). Server-only. Never expose to the browser.
PRIVATE_SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# Required for AI document editing (resume-builder OpenRouter client)
# https://openrouter.ai/keys
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Reserved — automations cron/worker (Phase 6)
# Not read by the app yet. Set a long random string now so Vercel cron can
# reuse it later. Leave empty locally until automations land.
# -----------------------------------------------------------------------------

CRON_SECRET=

# -----------------------------------------------------------------------------
# Site / product (referenced by layouts, header, footer, homepage)
# -----------------------------------------------------------------------------

# Browser title and public product name
NEXT_PUBLIC_PRODUCTNAME=

# CSS theme class on <body>. Defaults to theme-sass3 if empty.
# Valid: theme-sass, theme-sass2, theme-sass3, theme-blue, theme-purple, theme-green
NEXT_PUBLIC_THEME=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Google Analytics / Google tag ID. Omit or leave empty to skip the script.
NEXT_PUBLIC_GOOGLE_TAG=

# Comma-separated SSO providers enabled in the UI.
# Allowed values: github, google, facebook, apple
# Also enable the matching provider in the Supabase Auth dashboard.
# Example: google,github
NEXT_PUBLIC_SSO_PROVIDERS=

# Homepage pricing demo (HomePricing). All optional; empty = no tiers.
# Parallel comma-separated lists; features use | inside a tier.
# Example:
#   NEXT_PUBLIC_TIERS_NAMES=Free,Pro
#   NEXT_PUBLIC_TIERS_PRICES=0,12
#   NEXT_PUBLIC_TIERS_DESCRIPTIONS=Hobby,For teams
#   NEXT_PUBLIC_TIERS_FEATURES=Todos|Files,Todos|Files|AI
#   NEXT_PUBLIC_POPULAR_TIER=Pro
#   NEXT_PUBLIC_COMMON_FEATURES=Auth,MFA
NEXT_PUBLIC_TIERS_NAMES=
NEXT_PUBLIC_TIERS_PRICES=
NEXT_PUBLIC_TIERS_DESCRIPTIONS=
NEXT_PUBLIC_TIERS_FEATURES=
NEXT_PUBLIC_POPULAR_TIER=
NEXT_PUBLIC_COMMON_FEATURES=

# -----------------------------------------------------------------------------
# Not used / do not set
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY_REACHTHEMAI — legacy fallback in resume-builder/lib/openrouter.ts.
#   Do not set. Use OPENROUTER_API_KEY only.
# SUPABASE_SERVICE_ROLE_KEY — not read by this app.
# Composio / Treg / marketing-agent product keys — out of v1.
# NODE_ENV — set by Next.js. Do not add here.
