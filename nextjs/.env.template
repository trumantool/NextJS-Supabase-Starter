# =============================================================================
# Next.js + Supabase starter — environment template
# =============================================================================
# Copy to nextjs/.env.local and fill in values from a NEW empty Supabase project.
#
#   cp .env.template .env.local
#
# Never reuse Marketing Agent infrastructure:
#   - Do not use project ID glplvrljdgowcwuubkau
#   - Do not use Vercel project marketing-agent-truman
#   - Do not paste keys from those projects
#
# Composio is out of v1. Do not add Composio keys.
# Do not commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Supabase
# Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. This app reads PRIVATE_SUPABASE_SERVICE_KEY (not
# SUPABASE_SERVICE_ROLE_KEY). Server-only. Never expose to the browser.
PRIVATE_SUPABASE_SERVICE_KEY=

# -----------------------------------------------------------------------------
# Required for Documents AI, Chat, and Automations (OpenRouter client)
# https://openrouter.ai/keys
# Do not set OPENROUTER_API_KEY_REACHTHEMAI — the app does not read it.
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY=

# Resolution order for chat, documents, and automations:
#   1. user_settings.openrouter_api_key (BYOK), unless openrouter_force_platform_key is true
#   2. admin_settings.openrouter_api_key (empty seed; set in Admin Settings, never commit it)
#   3. OPENROUTER_API_KEY

# -----------------------------------------------------------------------------
# Optional — Stripe subscriptions (hosted Checkout + Customer Portal)
# Billing columns live on user_data. Webhook: POST /api/stripe/webhook
# STRIPE_PRICE_PLAN_MAP format: price_123:pro,price_456=team
# STRIPE_PRICE_ID overrides the map when starting Checkout.
# -----------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_PLAN_MAP=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Required for Automations cron/worker
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to:
#   GET /api/cron/automations     — enqueue due jobs (wake ≠ execute)
#   GET /api/workers/automations  — claim queued rows and run OpenRouter + skills
# Generate a long random string (openssl rand -hex 32). Never expose to the
# browser. If unset, both endpoints return 401.
# -----------------------------------------------------------------------------

CRON_SECRET=

# -----------------------------------------------------------------------------
# Site / product (referenced by layouts, header, footer, homepage)
# -----------------------------------------------------------------------------

# Browser title and public product name
NEXT_PUBLIC_PRODUCTNAME=

# Which admin_settings rows this deployment owns.
# Leave unset for a single-app starter. Existing and seeded rows use app_key NULL
# and keep working with no extra config.
# On a shared database, set a unique value (for example my-site) and copy rows
# for that key. See the root README, "Admin settings on a shared database".
# Server-only. Do not prefix with NEXT_PUBLIC_.
ADMIN_SETTINGS_APP_KEY=

# Which site this deployment owns in public.posts.website.
# Required for /posts, /my-posts, and /api/posts. There is no default.
# Allowed values only: edu, marketing-agent, afterallcare
# Set the value for the app you are deploying. Do not leave it empty.
POSTS_WEBSITE=

# Absolute origin for canonical URLs, Open Graph, the sitemap, and RSS.
# Leave empty until this deployment has a public host. Do not invent one.
NEXT_PUBLIC_SITE_ORIGIN=

# CSS theme class on <body>. Defaults to theme-sass3 if empty.
# Valid: theme-sass, theme-sass2, theme-sass3, theme-blue, theme-purple, theme-green
NEXT_PUBLIC_THEME=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Google Analytics / Google tag ID. Omit or leave empty to skip the script.
NEXT_PUBLIC_GOOGLE_TAG=

# Comma-separated SSO providers enabled in the UI.
# Allowed values: github, google, facebook, apple
# Also enable the matching provider in the Supabase Auth dashboard.
# Example: google,github
NEXT_PUBLIC_SSO_PROVIDERS=

# Homepage pricing demo (HomePricing). All optional; empty = no tiers.
# Parallel comma-separated lists; features use | inside a tier.
# Example:
#   NEXT_PUBLIC_TIERS_NAMES=Free,Pro
#   NEXT_PUBLIC_TIERS_PRICES=0,12
#   NEXT_PUBLIC_TIERS_DESCRIPTIONS=Hobby,For teams
#   NEXT_PUBLIC_TIERS_FEATURES=Todos|Files,Todos|Files|AI
#   NEXT_PUBLIC_POPULAR_TIER=Pro
#   NEXT_PUBLIC_COMMON_FEATURES=Auth,MFA
NEXT_PUBLIC_TIERS_NAMES=
NEXT_PUBLIC_TIERS_PRICES=
NEXT_PUBLIC_TIERS_DESCRIPTIONS=
NEXT_PUBLIC_TIERS_FEATURES=
NEXT_PUBLIC_POPULAR_TIER=
NEXT_PUBLIC_COMMON_FEATURES=

# -----------------------------------------------------------------------------
# Not used / do not set
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY_REACHTHEMAI — not read. Use OPENROUTER_API_KEY, a
#   per-user key in user_settings.openrouter_api_key (User Settings → BYOK),
#   or admin_settings.openrouter_api_key. Do not copy Marketing or Edu key rows.
# SUPABASE_SERVICE_ROLE_KEY — not read by this app.
# Composio / Treg / marketing-agent product keys — out of v1.
# NODE_ENV — set by Next.js. Do not add here.
